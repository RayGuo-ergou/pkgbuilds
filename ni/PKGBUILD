pkgname=ni
pkgver=30.6.0
pkgrel=3
pkgdesc='Use the right package manager'
arch=('any')
url='https://github.com/antfu-collective/ni'
license=('MIT')
# I dont want to install Node.js or pnpm via pacman, even makedepends
# so build after node setup (with tj/n) and installing pnpm
# or uncomment below
# depends=('nodejs>=20.19.0')
# makedepends=('pnpm')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Preserve upstream's catalogs while sharing packaging settings across commands.
  sed -i '/^# BEGIN packaging settings$/,/^# END packaging settings$/d' pnpm-workspace.yaml
  cat >>pnpm-workspace.yaml <<'EOF'

# BEGIN packaging settings
nodeLinker: isolated
packageImportMethod: copy
enableGlobalVirtualStore: false
storeDir: ../pnpm-store
# END packaging settings
EOF
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  local -a installer=(pnpm)
  if command -v sfw >/dev/null 2>&1; then
    installer=(sfw pnpm)
    printf 'Installing dependencies with sfw pnpm\n'
  else
    printf 'sfw not found; installing dependencies with pnpm directly\n'
  fi

  "${installer[@]}" install \
    --frozen-lockfile \
    --ignore-scripts \
    --prod=false
  "${installer[@]}" run build
  "${installer[@]}" prune --prod --ignore-scripts
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
  cp -a bin dist node_modules package.json "${pkgdir}/usr/lib/${pkgname}/"
  local cmd
  for cmd in na nd ni nr nci nlx nun nup; do
    ln -s "../lib/${pkgname}/bin/${cmd}.mjs" \
      "${pkgdir}/usr/bin/${cmd}"
  done
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
