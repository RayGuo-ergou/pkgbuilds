pkgname=sfw-free
pkgver=1.10.0
pkgrel=1
pkgdesc="Socket Workflow (free tier) — supply chain security CLI"
arch=('x86_64' 'aarch64')
url="https://github.com/SocketDev/sfw-free"
license=('custom')
provides=('sfw')
options=('!strip')

source_x86_64=("${pkgname}-${pkgver}-x86_64::https://github.com/SocketDev/sfw-free/releases/download/v${pkgver}/sfw-free-linux-x86_64")
source_aarch64=("${pkgname}-${pkgver}-aarch64::https://github.com/SocketDev/sfw-free/releases/download/v${pkgver}/sfw-free-linux-arm64")

sha256sums_x86_64=('1ea16f15f1217bde66ac9c7d0262c7126b7bb1b2d60e14e8fa0982456139ae6e')
sha256sums_aarch64=('d7e969c17e6d23ac1cb0dea81ff87ef9bca2d83570270d91aab14b2a7fb66ad4')

prepare() {
  chmod +x "${srcdir}/${pkgname}-${pkgver}-${CARCH}"
}

package() {
  install -Dm755 \
    "${srcdir}/${pkgname}-${pkgver}-${CARCH}" \
    "${pkgdir}/usr/local/bin/sfw"
}
