pkgname=taze
pkgver=21.3.0
pkgrel=2
pkgdesc='A modern CLI tool that keeps your dependencies fresh in any repo and monorepo'
arch=('any')
url='https://github.com/antfu-collective/taze'
license=('MIT')
# I dont want to install Node.js or pnpm via pacman, even makedepends
# so build after node setup (with tj/n) and installing pnpm
# or uncomment below
# depends=('nodejs>=20.19.0')
# makedepends=('pnpm')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  local -a installer=(pnpm)
  if command -v sfw >/dev/null 2>&1; then
    installer=(sfw pnpm)
    printf 'Installing dependencies with sfw pnpm\n'
  else
    printf 'sfw not found; installing dependencies with pnpm directly\n'
  fi

  # Preserve upstream's workspace catalogs and lockfile.
  "${installer[@]}" install \
    --frozen-lockfile \
    --ignore-scripts \
    --config.node-linker=isolated \
    --config.package-import-method=copy \
    --config.enableGlobalVirtualStore=false \
    --store-dir "${srcdir}/pnpm-store" \
    --prod=false
  "${installer[@]}" run build
  "${installer[@]}" prune --prod --ignore-scripts
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
  cp -a bin dist skills node_modules package.json "${pkgdir}/usr/lib/${pkgname}/"
  ln -s "../lib/${pkgname}/bin/taze.mjs" \
    "${pkgdir}/usr/bin/taze"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
